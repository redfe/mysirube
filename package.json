		"@tiptap/pm": "^2.11.0",
		"@tiptap/starter-kit": "^2.11.0",
		"@types/eslint": "^9.6.1",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.14.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"svelte": "^5.15.0",
