{
	"name": "mysirube",
	"version": "0.0.1",
	"devDependencies": {
		"@neodrag/svelte": "^2.3.2",
		"@playwright/test": "^1.51.0",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.19.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@tiptap-pro/extension-file-handler": "^2.17.5",
		"@tiptap-pro/extension-unique-id": "^2.17.5",
		"@tiptap/core": "^2.11.5",
		"@tiptap/extension-gapcursor": "^2.11.5",
		"@tiptap/extension-image": "^2.11.5",
		"@tiptap/extension-link": "^2.11.5",
		"@tiptap/extension-table": "^2.11.5",
		"@tiptap/extension-table-cell": "^2.11.5",
		"@tiptap/extension-table-header": "^2.11.5",
		"@tiptap/extension-table-row": "^2.11.5",
		"@tiptap/extension-youtube": "^2.11.5",
		"@tiptap/pm": "^2.11.5",
		"@tiptap/starter-kit": "^2.11.5",
		"@types/eslint": "^9.6.1",
		"bun": "^1.2.5",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"i": "^0.3.7",
		"mermaid": "^11.5.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.23.0",
		"svelte-check": "^4.1.5",
		"tiptap-extension-resize-image": "^1.2.1",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.1",
		"vite": "^5.4.14",
		"vitest": "^2.1.9"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"build:docs": "vite build && mkdir -p docs/$npm_package_version && mv build/index.html docs/$npm_package_version"
	},
	"type": "module"
}
