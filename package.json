{
	"name": "mysirube",
	"version": "0.0.1",
	"devDependencies": {
		"@neodrag/svelte": "^2.3.2",
		"@playwright/test": "^1.51.1",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.20.5",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.7",
		"@tiptap-pro/extension-file-handler": "^2.17.7",
		"@tiptap-pro/extension-unique-id": "^2.17.7",
		"@tiptap/core": "^2.11.7",
		"@tiptap/extension-gapcursor": "^2.11.7",
		"@tiptap/extension-image": "^2.11.7",
		"@tiptap/extension-link": "^2.11.7",
		"@tiptap/extension-table": "^2.11.7",
		"@tiptap/extension-table-cell": "^2.11.7",
		"@tiptap/extension-table-header": "^2.11.7",
		"@tiptap/extension-table-row": "^2.11.7",
		"@tiptap/extension-youtube": "^2.11.7",
		"@tiptap/pm": "^2.11.7",
		"@tiptap/starter-kit": "^2.11.7",
		"@types/eslint": "^9.6.1",
		"bun": "^1.2.9",
		"eslint": "^9.24.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"i": "^0.3.7",
		"jsdom": "^26.0.0",
		"mermaid": "^11.6.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.25.12",
		"svelte-check": "^4.1.5",
		"tiptap-extension-resize-image": "^1.2.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.29.1",
		"vite": "^6.2.6",
		"vitest": "^3.1.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run && bun run test:e2e",
		"test:e2e": "playwright test",
		"build:docs": "bun run check && bun run test && vite build && mkdir -p docs/$npm_package_version && mv build/index.html docs/$npm_package_version"
	},
	"type": "module"
}
